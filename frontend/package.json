{
  "name": "aiclip-studio",
  "version": "0.1.0",
  "description": "AI-powered desktop video editor (Electron + React shell)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:mask": "node --test tests/mask-math.test.cjs tests/mask-persistence.test.cjs tests/mask-tracking-lifecycle.test.cjs",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\""
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
